# Server-only secrets. Never expose these to the browser.
# The browser gets a short-lived single-use token from GET /api/voice-token instead.
ASSEMBLYAI_API_KEY=
# Filled in by `npm run publish` (PUT/POST https://agents.assemblyai.com/v1/agents)
AGENT_ID=
PORT=3000
# Bind host. 0.0.0.0 = reachable on the LAN (mobile demo); 127.0.0.1 = localhost only.
HOST=0.0.0.0
# Log verbosity: silent | error | warn | info | debug
LOG_LEVEL=info
# Set to 1 ONLY when running behind a trusted reverse proxy; reads X-Forwarded-For
# for rate limiting. Off by default — blindly trusting that header from clients
# lets attackers spoof their IP and bypass per-client limits.
TRUST_PROXY=0
