# CircuitMate production environment
# Server-only secrets — never share or commit this file.
#
# On the host:  sudo cp deploy/circuitmate.env.example /etc/circuitmate/circuitmate.env
#               sudo nano /etc/circuitmate/circuitmate.env   # fill the two secrets
#               sudo chmod 600 /etc/circuitmate/circuitmate.env
#               sudo systemctl restart circuitmate

# AssemblyAI API key. Never expose to the browser — the browser gets a
# short-lived single-use token from GET /api/voice-token instead.
ASSEMBLYAI_API_KEY=

# Agent ID. Filled in by `npm run publish` (PUT/POST https://agents.assemblyai.com/v1/agents).
# On a fresh host, run `npm run publish` there to register the agent and copy
# this value, or reuse the ID from your other environment.
AGENT_ID=

# Binding — loopback only: the Caddy/Nginx reverse proxy owns the public port.
PORT=3000
HOST=127.0.0.1

# 1 ONLY because this runs behind a trusted reverse proxy that rewrites
# X-Forwarded-For. Without it every request arrives from 127.0.0.1 and the
# per-client rate limits would globally throttle all visitors together.
TRUST_PROXY=1

# Log verbosity: silent | error | warn | info | debug
LOG_LEVEL=info